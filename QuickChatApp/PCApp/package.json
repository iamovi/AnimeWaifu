{
  "name": "QuickChat",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "go": "electron .",
    "boom": "electron-builder",
    "prebuild": "npm prune --production && npm run minify",
    "minify": "terser src/**/*.js --compress --mangle --output dist/"
  },
  "keywords": [
    "QuickChat",
    "AnimeWaifuProject",
    "ChatApo",
    "iamovi"
  ],
  "author": {
    "name": "Maruf Ovi",
    "email": "fornet.ovi@gmail.com"
  },
  "license": "MIT",
  "description": "A dedicated QuickChat App from AnimeWaifu Project!",
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "terser": "^5.10.0"
  },
  "dependencies": {},
  "build": {
    "asar": true,
    "appId": "com.quickchat.iamovi",
    "productName": "QuickChat",
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "QuickChatSetup.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "build/linux/png",
      "category": "Utility",
      "maintainer": "Maruf Ovi <fornet.ovi@gmail.com>",
      "compression": "normal"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/mac/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "niceexe-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "extraResources": [
    {
      "from": "LICENSE",
      "to": "LICENSE"
    }
  ],
  "files": [
    "dist/**/*",
    "build/**/*"
  ]
}
